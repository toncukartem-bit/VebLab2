@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["Title"];
}

<h2>@Localizer["Title"]</h2>

<form asp-action="Upload" asp-controller="Home" method="post" enctype="multipart/form-data">
    <div class="mb-3">
        <label>@Localizer["SelectFile"]</label>
        <input type="file" name="uploadedFile" class="form-control" style="max-width: 300px;" />
    </div>
    <button type="submit" class="btn btn-primary">@Localizer["UploadButton"]</button>
</form>