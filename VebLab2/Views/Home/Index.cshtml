@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model VebLab2.Models.EmailViewModel

<h2>@Localizer["FormTitle"]</h2>

<form asp-action="SendEmail" method="post">
    <div>
        <label>@Localizer["EmailLabel"]</label>
        <input asp-for="Email" type="email" required />
    </div>
    <br />
    <div>
        <label>@Localizer["MessageLabel"]</label>
        <textarea asp-for="Message" required></textarea>
    </div>
    <br />
    <button type="submit">@Localizer["SubmitButton"]</button>
</form>


@if (ViewBag.Success != null)
{
    <h3 style="color: green;">@ViewBag.Success</h3>
}