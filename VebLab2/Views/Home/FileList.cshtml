@model List<string>
@{
    ViewData["Title"] = "Список файлів";
}

<div class="text-center mt-5">
    <h2>Доступні файли на сервері</h2>
    <hr />

    @if (Model.Count == 0)
    {
        <p class="text-muted">Немає завантажених файлів.</p>
    }
    else
    {
        <ul class="list-group w-50 mx-auto">
            @foreach (var fileName in Model)
            {
                <!-- Це реалізація Пункту 3: перехід на файл при кліку -->
                <li class="list-group-item">
                    <a href="~/Files/@fileName" target="_blank">@fileName</a>
                </li>
            }
        </ul>
    }
    
    <div class="mt-4">
        <a asp-action="Upload" asp-controller="Home" class="btn btn-primary">Завантажити ще один файл</a>
    </div>
</div>